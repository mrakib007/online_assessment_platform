// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  employer
  candidate
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  role        Role
  createdAt   DateTime     @default(now())
  onlineTests OnlineTest[]
}

model OnlineTest {
  id                     Int        @id @default(autoincrement())
  title                  String
  candidates             Int?
  questionSet            Int?
  questionType           String?
  negativeMarkingEnabled Boolean    @default(false)
  negativeMarkingPenalty Int        @default(0)
  questions              Question[]
  timeSlots              TimeSlot[]
  createdBy              Int
  user                   User       @relation(fields: [createdBy], references: [id])
  createdAt              DateTime   @default(now())
}

model TimeSlot {
  id            Int        @id @default(autoincrement())
  testId        Int
  test          OnlineTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime
  maxCandidates Int
  createdAt     DateTime   @default(now())

  @@index([testId])
}

model Question {
  id        Int        @id @default(autoincrement())
  testId    Int
  test      OnlineTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  setNumber Int        @default(1)
  type      String
  text      String     @db.Text
  points    Int        @default(1)
  options   Json?
  createdAt DateTime   @default(now())

  @@index([testId])
  @@index([testId, setNumber])
}

model ExamSubmission {
  id             Int      @id @default(autoincrement())
  testId         Int
  candidateId    Int
  candidateEmail String
  answers        Json     @default("[]")
  assignedSet    Int      @default(1)
  submittedAt    DateTime @default(now())

  @@unique([testId, candidateId])
  @@index([testId])
  @@index([candidateId])
}

model ExamSession {
  id          Int      @id @default(autoincrement())
  testId      Int
  candidateId Int
  assignedSet Int      @default(1)
  startedAt   DateTime @default(now())

  @@unique([testId, candidateId])
  @@index([testId, candidateId])
  @@index([testId, assignedSet])
}
